{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ThothChat",
  "version": "0.1.0",
  "identifier": "com.facincanitech.thothchat.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cross-env VITE_TAURI=1 npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "ThothChat",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
